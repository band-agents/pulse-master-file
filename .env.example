# Pulse Environment Variables
# Copy this file to .env.local and fill in your values.
# When these variables are absent, Pulse runs in demo mode with sample data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clinical assistant (Echo) — set via Supabase Edge Functions secrets:
# supabase secrets set OPENAI_API_KEY=sk-...

# Dev-only bypass. Put this in .env.development.local (not here) to open
# straight on the command centre with no landing page or sign-in:
# VITE_SKIP_AUTH=true
